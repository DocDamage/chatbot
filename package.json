{
  "name": "ai-chatbot-hub",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist/**",
    "client/dist/**",
    "config/**",
    "docs/architecture/generated/sbom.cyclonedx.json",
    ".env.example",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=10"
  },
  "description": "Production-grade AI chatbot with contract-based control, memory stratification, and provider abstraction",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "cd client && npm run build",
    "start": "node dist/server/index.js",
    "start:prod": "npm run build && npm start",
    "setup:native-runtime": "node scripts/native/setup-local-runtime.mjs",
    "certify:game-editors": "tsx scripts/native/certify-game-editors.ts",
    "certify:production-like": "node scripts/certification/production-like.mjs",
    "certify:load": "node scripts/certification/http-load.mjs",
    "type-check": "npm run type-check:server && npm run type-check:tests && npm run type-check:client",
    "type-check:server": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "type-check:client": "cd client && npm run type-check",
    "release:check": "npm run release:server && npm run release:client && npm run release:package",
    "release:server": "npm run type-check:server && npm run type-check:tests && npm run lint:server && npm run test:release && npm run test:coverage -- --runInBand",
    "release:client": "npm run type-check:client && npm run lint:client && cd client && npm run test && npm run coverage && npm run a11y",
    "release:package": "npm run smoke:package",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "node scripts/release/run-server-coverage.mjs",
    "check:server-coverage": "node scripts/release/check-server-coverage.mjs",
    "test:unit": "jest --testPathPattern=__tests__",
    "test:integration": "jest --testPathPattern=server/__tests__",
    "test:security": "jest --runTestsByPath src/server/__tests__/release-security.test.ts",
    "test:routes": "jest --runTestsByPath src/server/routeManifest.test.ts src/server/chatRequest.test.ts src/types/chat.test.ts src/middleware/apiErrorSchema.test.ts src/server/routes/setup.test.ts src/server/routes/__tests__/feature-expansion-routes.test.ts",
    "test:services": "jest --runTestsByPath src/core/agents/PatchGenerator.test.ts src/core/config/APIKeyManager.test.ts src/core/conversation/ConversationManager.test.ts src/core/files/FileExplorerService.test.ts src/core/initialization/ServiceInitializer.test.ts src/core/knowledge/OnlineKnowledgeIngestionService.test.ts",
    "test:release": "npm run test:security -- --runInBand && npm run test:routes -- --runInBand && npm run test:services -- --runInBand && npm run test:e2e",
    "test:e2e:services": "jest --testPathPattern=e2e",
    "test:browser:prepare": "node scripts/browser/prepare-browser-e2e.mjs --confirm-browser-e2e-reset",
    "test:browser": "npm run test:browser:prepare && npm run build && npm --prefix client run test:browser",
    "test:e2e": "npm run test:e2e:services -- --runInBand && npm run test:browser",
    "smoke:package": "npm run build && node scripts/verify-package-smoke.mjs",
    "eval:rag": "tsx scripts/run-evals.ts rag",
    "eval:safety": "tsx scripts/run-evals.ts safety",
    "eval:all": "tsx scripts/run-evals.ts all",
    "eval:math": "tsx scripts/run-domain-evals.ts math",
    "eval:market": "tsx scripts/run-domain-evals.ts market",
    "eval:gamedev": "tsx scripts/run-domain-evals.ts gamedev",
    "eval:genius": "tsx scripts/run-domain-evals.ts all",
    "eval:sixsigma": "tsx scripts/run-domain-evals.ts sixsigma",
    "eval:blackbelt": "tsx scripts/run-domain-evals.ts sixsigma",
    "eval:popculture": "tsx scripts/run-domain-evals.ts popculture",
    "eval:history": "tsx scripts/run-domain-evals.ts history",
    "eval:science": "tsx scripts/run-domain-evals.ts science",
    "eval:chrono": "tsx scripts/run-domain-evals.ts all",
    "eval:music": "tsx scripts/run-domain-evals.ts music",
    "eval:suno": "tsx scripts/run-domain-evals.ts music/suno",
    "eval:daw": "tsx scripts/run-domain-evals.ts music/daw",
    "eval:story": "tsx scripts/run-domain-evals.ts story",
    "eval:legal": "tsx scripts/run-domain-evals.ts legal",
    "eval:health": "tsx scripts/run-domain-evals.ts health",
    "eval:security": "tsx scripts/run-domain-evals.ts security",
    "eval:business": "tsx scripts/run-domain-evals.ts business",
    "eval:creative": "tsx scripts/run-domain-evals.ts creative",
    "eval:roleplay": "tsx scripts/run-domain-evals.ts creative/roleplay",
    "eval:philosophy": "tsx scripts/run-domain-evals.ts philosophy",
    "eval:language": "tsx scripts/run-domain-evals.ts language",
    "eval:geography": "tsx scripts/run-domain-evals.ts geography",
    "eval:engineering": "tsx scripts/run-domain-evals.ts engineering",
    "eval:coding": "tsx scripts/run-coding-evals.ts",
    "eval:nlu": "tsx scripts/run-domain-evals.ts nlu",
    "eval:knowledge-os": "tsx scripts/run-domain-evals.ts knowledge-os",
    "import:general": "tsx scripts/import-wikipedia-general-corpus.ts",
    "import:books": "tsx scripts/import-books.ts",
    "export:skill": "tsx scripts/export-skill.ts",
    "kb:backup": "tsx scripts/backup-knowledge-db.ts",
    "chat:runtime:smoke": "tsx scripts/canonical-cli.ts chat:runtime:smoke",
    "chat:runtime:golden": "tsx scripts/canonical-cli.ts chat:runtime:golden",
    "chat:runtime:shadow-report": "tsx scripts/canonical-cli.ts chat:runtime:shadow-report",
    "knowledge:list": "tsx scripts/canonical-cli.ts knowledge:list",
    "knowledge:verify-manifests": "tsx scripts/canonical-cli.ts knowledge:verify-manifests",
    "knowledge:install": "tsx scripts/canonical-cli.ts knowledge:install",
    "knowledge:update": "tsx scripts/canonical-cli.ts knowledge:update",
    "knowledge:verify": "tsx scripts/canonical-cli.ts knowledge:verify",
    "knowledge:stats": "tsx scripts/canonical-cli.ts knowledge:stats",
    "eval:chat": "tsx scripts/canonical-cli.ts eval:chat",
    "eval:retrieval": "tsx scripts/canonical-cli.ts eval:retrieval",
    "eval:tool-truth": "tsx scripts/canonical-cli.ts eval:tool-truth",
    "eval:datasets": "tsx scripts/canonical-cli.ts eval:datasets",
    "check:chat-runtime": "tsx scripts/canonical-cli.ts check:chat-runtime",
    "check:knowledge-licenses": "tsx scripts/canonical-cli.ts check:knowledge-licenses",
    "check:knowledge-provenance": "tsx scripts/canonical-cli.ts check:knowledge-provenance",
    "test:chat-runtime": "jest --testPathPattern=src/core/chat --runInBand",
    "test:conversation-state": "jest --testPathPattern=src/core/state --runInBand",
    "test:context-planner": "jest src/core/chat/__tests__/context-planner-matrix.test.ts --runInBand",
    "test:knowledge": "jest --testPathPattern=src/core/knowledge --runInBand",
    "test:knowledge:migrations": "jest src/core/knowledge/__tests__/knowledge-infrastructure-integration.test.ts --runInBand",
    "test:retrieval": "jest src/core/knowledge/__tests__/coding-retrieval-policy.test.ts src/core/knowledge/__tests__/general-retrieval-policy.test.ts src/core/knowledge/__tests__/knowledge-router.test.ts --runInBand",
    "test:model-policy": "jest src/core/providers/__tests__/model-registry-policy.test.ts --runInBand",
    "test:prompt-assembler": "jest src/core/prompt/__tests__/prompt-assembler.test.ts --runInBand",
    "test:grounding": "jest src/core/evals/__tests__/grounding-abstention.test.ts --runInBand",
    "test:tool-truth": "jest src/core/tools/__tests__/tool-truthfulness-failure.test.ts --runInBand",
    "test:feedback": "jest src/core/feedback/__tests__/feedback-consolidation-integration.test.ts --runInBand",
    "test:chat-diagnostics": "jest src/core/diagnostics/__tests__/chat-diagnostics.test.ts --runInBand",
    "eval:chat:smoke": "jest src/core/evals/__tests__/golden-regression-suite.test.ts --runInBand",
    "eval:chat:full": "tsx scripts/canonical-cli.ts chat:runtime:golden",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "eslint src",
    "lint:client": "eslint client/src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "release:inventory": "node scripts/release/generate-repository-inventory.mjs",
    "generate:sbom": "tsx scripts/release/generate-cyclonedx-sbom.ts",
    "generate:notices": "node scripts/release/generate-third-party-notices.mjs",
    "check:dependencies": "node scripts/release/check-dependency-vulnerabilities.mjs",
    "check:secrets": "node scripts/release/check-secrets.mjs",
    "check:secrets:history": "node scripts/release/check-secrets.mjs --history",
    "build:release-artifact": "npm run build && node scripts/release/build-release-artifact.mjs",
    "audit:release": "node scripts/release/run-comprehensive-audit.mjs",
    "audit:release:quick": "node scripts/release/run-comprehensive-audit.mjs --quick",
    "audit:release:strict": "node scripts/release/run-comprehensive-audit.mjs --strict",
    "check:source-integrity": "node scripts/release/check-source-integrity.mjs",
    "inventory:generate": "node scripts/release/generate-repository-inventory.mjs",
    "check:inventory": "node scripts/release/check-repository-inventory.mjs",
    "check:reachability": "node scripts/release/check-production-boundary.mjs",
    "check:file-size": "node scripts/release/check-file-size.mjs",
    "check:env": "node scripts/release/check-environment-contract.mjs",
    "check:docs": "node scripts/release/check-docs.mjs",
    "report:server-branch-gaps": "node scripts/release/report-server-branch-gaps.mjs",
    "test:release-tools": "node --test scripts/release/__tests__/phase2-scanners.test.mjs scripts/release/__tests__/server-coverage-policy.test.mjs scripts/release/__tests__/server-branch-report.test.mjs scripts/release/__tests__/comprehensive-audit-tools.test.mjs",
    "check:phase2": "npm run test:release-tools && npm run check:source-integrity && npm run check:inventory && npm run check:reachability && npm run check:file-size && npm run check:env && npm run check:docs",
    "verify:fast": "npm run type-check:server && npm run type-check:tests && npm run lint:server && npx jest src/core/coding/architecture/ArchitectureRelationshipsCoverage.test.ts src/core/coding/retrieval/GatewayLexicalRetrievalProvider.test.ts --runInBand",
    "verify:capability-fusion": "npm run verify:fast && npx jest src/core/coding/security/ApprovedRepositoryGateway.test.ts src/core/coding/architecture src/core/coding/retrieval src/core/agents/CodingAgent.test.ts --runInBand",
    "verify:milestone": "npm run verify:capability-fusion && npm run type-check:client && npm run lint:client && npm run test:release && npm run test:coverage -- --runInBand && npm run inventory:generate && git diff --exit-code -- docs/architecture/generated/",
    "verify:release": "npm run release:check && npm run check:phase2 && npm run check:dependencies && npm run check:secrets"
  },
  "keywords": [
    "ai",
    "chatbot",
    "llm",
    "rag"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.9",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^4.2.0",
    "@toon-format/toon": "^2.1.0",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.0.0-rc.12",
    "compromise": "^14.14.5",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "ml-distance": "^2.1.1",
    "mobi": "^0.0.1",
    "multer": "^1.4.5-lts.1",
    "natural": "^8.1.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "openai": "^4.20.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "puppeteer": "^25.9.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-swift": "^0.7.1",
    "twilio": "^5.11.1",
    "typescript": "^5.3.3",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "ws": "^8.16.0",
    "xml2js": "^0.6.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/natural": "^5.1.5",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0"
  },
  "overrides": {
    "adm-zip": "$adm-zip",
    "sharp": "$sharp"
  }
}
