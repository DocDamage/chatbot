# AI Chatbot Hub canonical environment template
# Copy to .env for local development. Never commit .env or real secrets.
# Markers: [required], [optional], [local-only]. Hosted production fails fast on unsafe values.

# Runtime
NODE_ENV=development
DEPLOYMENT_MODE=development
PORT=3001
# BASE_URL=
STARTUP_TIMEOUT_MS=30000
REQUEST_READY_TIMEOUT_MS=10000

# Security
JWT_SECRET=replace-with-at-least-32-random-characters
# CSRF_TOKEN=
# API_KEY_ENCRYPTION_SECRET=
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Observability
LOG_LEVEL=info

# Primary provider selection
LLM_PROVIDER=template
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2
USE_HUGGINGFACE=false
# HUGGINGFACE_MODEL=
# HUGGINGFACE_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_PROVIDER_NAME=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
MAX_COST_PER_REQUEST=0.10
MAX_LATENCY_MS=5000
MAX_RETRIES=3

# Embeddings and RAG
EMBEDDING_PROVIDER=xenova
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_USE_TRANSFORMERS=false
ENABLE_RAG=true
RAG_PERSISTENCE=true
RAG_SQLITE_PATH=./data/chatbot.db
# RAG_DATABASE_URL=
# DATABASE_URL=
RAG_RETRIEVAL_MODE=memory
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7
RAG_GENERATE_EMBEDDINGS=true
RAG_CHUNK_SIZE=500
KNOWLEDGE_BASE_DIR=./knowledge-base
EAGER_KNOWLEDGE_LOAD=false
EAGER_CODING_KNOWLEDGE_LOAD=false
GROUNDING_MODE=off
GROUNDING_REQUIRED_COVERAGE=0.8
RERANKER_MODE=heuristic

# Optional PyScrappy MCP research bridge (disabled unless explicitly enabled).
# PYSCRAPPY_ENABLED=true
# PYSCRAPPY_MCP_COMMAND=pyscrappy-mcp
# PYSCRAPPY_MCP_ARGS=[]
# PYSCRAPPY_SCRAPE_TOOL=scrape_url
# PYSCRAPPY_MAX_OUTPUT_BYTES=200000

# Cache
ENABLE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379
ENABLE_DISK_CACHE=true
DISK_CACHE_DIR=./cache
SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.7

# Feature flags
ENABLE_CONTRACTS=true
ENABLE_MEMORY=true
ENABLE_PROVENANCE=true
ENABLE_CACHING=true
ENABLE_MODEL_ROUTING=true
MODEL_ROUTING_ENABLED=true
ENABLE_ENSEMBLE=false
ENSEMBLE_ENABLED=false
ENABLE_SAFETY_PIPELINE=true
ENABLE_SEMANTIC_CACHE=true
ENABLE_WEBSOCKET=true
ENABLE_TOOL_CALLING=true

# Local-only execution and desktop integrations
ENABLE_BASH_EXECUTOR=false
ENABLE_LOCAL_TOOLS=false
LOCAL_EXECUTION_ENABLED=false
LOCAL_TOOLS_DIR=./local-tools
PRIVATE_TOOL_BUNDLES_DIR=./data/tools/private-bundles
SPRITE_LAB_DIR=./data/sprite-lab
AUDIO_LAB_DIR=./data/audio-lab
ENABLE_FL_STUDIO_MCP=false

# Vision
USE_LLAVA=false
LLAVA_MODEL=llava
USE_GEMINI_VISION=false
USE_GPT4V=false

# External integrations
# SEC_USER_AGENT=AIChatbotHub/1.0 contact@example.com
SEC_DATA_DIR=./data/sec
SEC_MAX_REQUESTS_PER_SECOND=8
# GITHUB_TOKEN=
# YOUTUBE_API_KEY=
# STACKOVERFLOW_API_KEY=
# NEWS_API_KEY=
# GUARDIAN_API_KEY=
# NYTIMES_API_KEY=
# TMDB_API_KEY=
# FRED_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Safety
SAFETY_CHECK_FACTS=true
SAFETY_CONFIDENCE_THRESHOLD=0.7

