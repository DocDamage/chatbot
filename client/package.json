{
  "name": "ai-chatbot-client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:pages": "vitest run src/api/runtime.test.ts src/components/StaticDemo.test.tsx src/App.static-demo.test.tsx",
    "coverage": "node --test ../scripts/release/__tests__/client-coverage-policy.test.mjs && vitest run --coverage && node ../scripts/release/check-client-coverage.mjs",
    "test:a11y:unit": "vitest run src/components/ModeSelector.test.tsx src/components/SettingsMenu.test.tsx src/components/StatusBar.test.tsx src/components/StaticDemo.test.tsx",
    "test:a11y:deps": "node scripts/prepare-a11y-tools.mjs",
    "test:a11y:browsers": "node .a11y-tools/node_modules/@playwright/test/cli.js install --with-deps chromium",
    "test:a11y:e2e": "node .a11y-tools/node_modules/@playwright/test/cli.js test --config=playwright.a11y.config.mjs",
    "test:a11y": "npm run test:a11y:unit && npm run test:a11y:deps && npm run test:a11y:browsers && npm run test:a11y:e2e",
    "a11y": "npm run test:a11y",
    "build": "tsc && vite build",
    "build:pages": "tsc && vite build",
    "smoke:pages": "node ../scripts/release/smoke-pages-artifact.mjs dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.7"
  }
}
